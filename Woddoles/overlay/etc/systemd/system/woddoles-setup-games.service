[Unit]
Description=Woddoles: instala Sober e TLauncher na primeira vez com internet
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/woddoles/games-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/woddoles-setup-games
Restart=on-failure
RestartSec=60
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
