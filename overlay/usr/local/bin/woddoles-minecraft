#!/bin/bash
# Abre o TLauncher (Minecraft). Baixa o launcher na primeira vez.
JAR="$HOME/.tlauncher/TLauncher.jar"

if [ ! -s "$JAR" ]; then
  woddoles-get-tlauncher || exit 1
fi

# O Java do próprio launcher fica leve; a RAM do jogo se ajusta dentro do TLauncher
# (Configurações > Alocação de memória: use ~1536 MB neste notebook).
exec java -Xmx256m -jar "$JAR"
