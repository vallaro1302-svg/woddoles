#!/bin/bash
# Roda como root: prepara Flathub + Sober e baixa o TLauncher para o usuário woddoles.
# Usado direto pelo install-woddoles.sh e, na ISO, pelo serviço de primeiro boot.
set -u
MARK=/var/lib/woddoles/games-done
[ -f "$MARK" ] && exit 0

flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || exit 1
flatpak install --system -y --noninteractive flathub org.vinegarhq.Sober || exit 1

if id woddoles >/dev/null 2>&1; then
  su - woddoles -c "woddoles-get-tlauncher" || echo "TLauncher: baixe depois pelo menu do Woddoles."
fi

mkdir -p /var/lib/woddoles
touch "$MARK"
